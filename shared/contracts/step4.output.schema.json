    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "from",
        "because"
      ],
      "properties": {
        "code": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "from": {
          "enum": [
            "chosen",
            "base_style",
            "none"
          ]
        },
        "because": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "batch_l": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "from",
        "because"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "from": {
          "enum": [
            "stated",
            "profile"
