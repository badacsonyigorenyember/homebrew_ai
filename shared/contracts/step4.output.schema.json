{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "step4.output",
  "description": "Step 4, targets: the style used, batch size, OG, FG, ABV, IBU and SRM targets, mash temperature, the hint knobs applied and the conflicts, each number with where it came from. Absent: a target value null with from none (the style has no such range); style.code and style.name null with from none (no usable style).",
  "type": "object",
  "required": [
    "style",
    "batch_l",
    "targets",
    "mash_c",
    "knobs",
    "conflicts",
    "guidance"
  ],
  "additionalProperties": false,
