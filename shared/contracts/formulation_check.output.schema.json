{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "formulation_check.output",
  "description": "Formulation check output: the computed numbers and one result per checked rule. Absent: a number that cannot be computed is null and its missing field is named in numbers.missing; a rule that cannot be checked has status unknown and names the missing field.",
  "type": "object",
  "required": [
    "calc_version",
    "numbers",
    "results"
  ],
  "additionalProperties": false,
  "properties": {
    "calc_version": {
      "type": "string"
    },
    "numbers": {
      "type": "object",
      "required": [
        "og",
        "fg",
        "abv",
        "srm",
        "ibu",
        "attenuation_pct",
        "missing"
      ],
      "additionalProperties": false,
      "properties": {
        "og": {
          "type": [
            "number",
            "null"
          ]
        },
        "fg": {
          "type": [
            "number",
            "null"
          ]
        },
        "abv": {
          "type": [
            "number",
            "null"
          ]
        },
        "srm": {
          "type": [
            "number",
            "null"
          ]
        },
        "ibu": {
          "type": [
            "number",
            "null"
          ]
        },
        "attenuation_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "status",
          "message",
          "failures",
          "missing"
        ],
        "additionalProperties": false,
        "properties": {
          "rule": {
            "type": "integer",
            "minimum": 1,
            "maximum": 13
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "message": {
            "type": "string"
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "items",
                "value",
                "limit"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "ingredient_id",
                      "name"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "ingredient_id": {
                        "type": "integer"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  }
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "limit": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
