{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "choose.input",
  "description": "Input of the steps 6-9 sub-workflow: the run, the brief and what steps 2, 0, 4 and 5 produced, and the model settings of the one LLM call.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "brief",
    "style",
    "profile",
    "targets",
    "frame",
    "feedback",
    "model",
    "think",
    "temperature",
    "seed"
  ],
  "properties": {
    "run_id": {
      "type": "integer"
    },
    "brief": {
      "type": "object"
    },
    "style": {
      "type": "object"
    },
    "profile": {
      "type": "object"
    },
    "targets": {
      "type": "object"
    },
    "frame": {
      "type": "object"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "think": {
      "type": "boolean"
    },
    "temperature": {
      "type": "number"
    },
    "seed": {
      "type": "integer"
    },
    "feedback": {
      "description": "Null on try 1. On a retry: step 11's failures, the pick bans and the failed try's picks (R4).",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "try",
            "lines",
            "banned",
            "last"
          ],
          "properties": {
            "try": {
              "type": "integer",
              "minimum": 2,
              "maximum": 3
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "banned": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ingredient_id",
                  "name",
                  "why"
                ],
                "properties": {
                  "ingredient_id": {
                    "type": "integer"
                  },
                  "name": {
                    "type": "string"
                  },
                  "why": {
                    "type": "string"
                  }
                }
              }
            },
            "last": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fermentables",
                "hops",
                "yeast",
                "extras"
              ],
              "properties": {
                "fermentables": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "hops": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "yeast": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "extras": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
