{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "step9.input",
  "description": "Step 9, choose extras: the misc rows of the candidate table (usages, time, sourced dose), the slots and inventory words, the excluded products.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "style_used",
    "wanted_style",
    "guidance",
    "candidates",
    "slots",
    "inventory_words",
    "excluded"
  ],
  "properties": {
    "run_id": {
      "type": "integer"
    },
    "style_used": {
      "type": [
        "string",
        "null"
      ]
    },
    "wanted_style": {
      "type": [
        "string",
        "null"
      ]
    },
    "guidance": {
      "type": "boolean"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "inventory_words": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
