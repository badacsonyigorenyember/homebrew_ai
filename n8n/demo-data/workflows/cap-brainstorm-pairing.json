    },
    {
      "parameters": {
        "jsCode": "// The corpus never mentions this anchor, so there is no answer to give and no\n// grounded candidate to build one from. Say that, in one sentence, and stop —\n// the alternative is the propose step manufacturing adjacent filler from six\n// passages that happen to rank highest without being about anything relevant.\nconst p = $input.first().json;\nreturn [{ json: {\n  run_id: p.run_id,\n  status: 'refused',\n  spent:  JSON.stringify({ reason: 'anchor_not_in_corpus', anchor: p.anchor }),\n  answer: `Your library has nothing on ${p.anchor}. I can't answer this from the books you've ingested, and I'm not going to answer it from my own memory.`,\n}}];"
      },
      "type": "n8n-nodes-base.code",
