      "id": "22cfbada-648a-458b-8d68-614acfd5ed2b",
      "name": "Step 2b · retrieve technique"
    },
    {
      "parameters": {
        "jsCode": "const base = $('Unpack parse').first().json;\nconst a = $('Step 2a · retrieve anchor').first().json.rows ?? [];\nconst b = $input.first().json.rows ?? [];\n\n// Deduplicate by chunk_id, then relabel S1..Sn across BOTH retrievals. Each call\n// numbers from S1 independently, so using their labels would collide.\nconst seen = new Map();\nfor (const r of [...a, ...b]) if (!seen.has(r.chunk_id)) seen.set(r.chunk_id, r);\nconst rows = [...seen.values()];\n\nif (!rows.length) throw new Error(`No passages found for \"${base.anchor}\"`);\n\nconst idmap = {};\nconst passages = rows.map((r, n) => {\n  const label = `S${n + 1}`;\n  idmap[r.chunk_id] = { label, doc_title: r.doc_title, page: r.page };\n  return `[${label}] (chunk_id ${r.chunk_id}) ${r.doc_title} · ${r.heading}${r.page ? ` · p.${r.page}` : ''}\\n${r.text}`;\n}).join('\\n\\n');\n\n// ⛔ Coverage gate. nlq.search_knowledge returns a pure RRF score — 1/(rrf_k + rank) —\n// so it is a function of rank alone and says NOTHING about relevance: an unrelated\n// chunk scores exactly what a perfect hit scores. Retrieval therefore always returns\n// six passages, even for an anchor the corpus has never heard of, and the propose\n// step will dutifully invent something adjacent from them.\n// The only honest signal available is lexical: did anything we retrieved actually\n// mention the thing that was asked about?\nconst needle = String(base.anchor ?? '').trim().toLowerCase();\nconst hay = rows.map(r => `${r.doc_title} ${r.heading} ${r.text}`).join(' ').toLowerCase();\nconst anchor_covered = needle.length > 2 && hay.includes(needle);\n\nreturn [{ json: { ...base, passages, idmap, anchor_covered,\n                  chunk_ids: rows.map(r => r.chunk_id) } }];"
      },
