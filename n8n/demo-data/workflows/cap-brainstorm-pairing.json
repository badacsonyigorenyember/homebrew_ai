        "jsCode": "// Only one branch of `Anchor covered?` ran, so ask which before reading it —\n// $('node').first() on a node that never executed throws.\nconst src = $('Wrap answer').isExecuted\n  ? $('Wrap answer').first().json\n  : $('Not in library').first().json;\n\n// One item, one key — the toolWorkflow node hands the last output to the model.\nreturn [{ json: { response: String(src.answer ?? '').trim() } }];"
