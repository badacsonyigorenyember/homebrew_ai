# =============================================================================
# Secrets — never commit
# (the bare `.env` pattern matches .env in ANY dir: scripts/.env, etc.)
# =============================================================================
.env
.env.*
!.env.example
supabase/docker/.env

# =============================================================================
# Supabase runtime data (PGDATA + generated volumes) — regenerated on `up`
# =============================================================================
supabase/docker/volumes/db/data/
supabase/docker/volumes/storage/
supabase/docker/volumes/functions/*
!supabase/docker/volumes/functions/main/

# =============================================================================
# Ingestion working area — keep the folder skeleton, not the payloads (§6.5)
# =============================================================================
shared/rag-files/pending/*
!shared/rag-files/pending/.gitkeep
shared/rag-files/processing/*
!shared/rag-files/processing/.gitkeep
shared/rag-files/processed/*
!shared/rag-files/processed/.gitkeep
shared/rag-files/failed/*
!shared/rag-files/failed/.gitkeep
shared/extracted-images/*
!shared/extracted-images/.gitkeep
shared/docling-scratch/

# n8n import marker
n8n/demo-data/.imported

# =============================================================================
# Tooling / local settings
# =============================================================================
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node (if any tooling is added later)
node_modules/

# Logs & temp
*.log
*.tmp
*.bak

# =============================================================================
# OS & editor cruft
# =============================================================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
