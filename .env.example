# =============================================================================
# Homebrewing Assistant — environment TEMPLATE
# Do not fill this in by hand. Generate a real .env with strong, fresh secrets
# (including a valid Supabase JWT_SECRET + signed ANON_KEY/SERVICE_ROLE_KEY):
#
#     python3 scripts/gen-env.py > .env
#
# The values below are placeholders shown only to document the required keys.
# =============================================================================

# --- n8n metadata Postgres (workflow definitions only) -----------------------
N8N_POSTGRES_USER=root
N8N_POSTGRES_PASSWORD=CHANGE_ME
N8N_POSTGRES_DB=n8n

# --- n8n app secrets ---------------------------------------------------------
N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_USER_MANAGEMENT_JWT_SECRET=CHANGE_ME
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# --- Ollama / models (architecture §4) --------------------------------------
# Verify these tags exist on ollama.com/library before first pull (§4.3).
OLLAMA_CHAT_MODEL=gemma4:12b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_HOST=ollama:11434

# --- image serving (architecture §3.8) --------------------------------------
IMAGE_BASE_URL=http://localhost:8080

# --- app DB roles the n8n agent uses (architecture §8.4) --------------------
AGENT_DB_PASSWORD=CHANGE_ME
MEM_WRITER_DB_PASSWORD=CHANGE_ME

# =============================================================================
# Supabase local stack (app database — kb/brew/mem/nlq live here)
# ANON_KEY and SERVICE_ROLE_KEY must be JWTs signed with JWT_SECRET.
# =============================================================================
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_min_32_chars
ANON_KEY=CHANGE_ME_signed_jwt
SERVICE_ROLE_KEY=CHANGE_ME_signed_jwt
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=CHANGE_ME
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SECRET_KEY_BASE=CHANGE_ME
VAULT_ENC_KEY=CHANGE_ME_exactly_32_chars
PG_META_CRYPTO_KEY=CHANGE_ME_min_32_chars

SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=CHANGE_ME
POOLER_DB_POOL_SIZE=5
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
PGRST_DB_SCHEMAS=public,storage,graphql_public
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true
STUDIO_DEFAULT_ORGANIZATION=Homebrew Assistant
STUDIO_DEFAULT_PROJECT=Homebrew Assistant
OPENAI_API_KEY=
IMGPROXY_AUTO_WEBP=true
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
S3_PROTOCOL_ACCESS_KEY_ID=stub
S3_PROTOCOL_ACCESS_KEY_SECRET=stub
FUNCTIONS_VERIFY_JWT=false
